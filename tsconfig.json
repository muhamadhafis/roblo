{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nomnom/shared": ["packages/shared/src/index.ts"],
      "@nomnom/shared/*": ["packages/shared/src/*"]
    }
  }
}

{
  "name": "nomnom-throw",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server:dev": "bun --watch apps/server/src/index.ts",
    "web:dev": "bun --filter @nomnom/web dev",
    "db:seed": "bun apps/server/src/db/migrate-and-seed.ts",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:security": "bun test tests/security",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/three": "^0.170.0",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "three": "^0.170.0"
  }
}
